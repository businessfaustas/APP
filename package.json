{
  "name": "flagbid",
  "version": "1.0.0",
  "private": true,
  "description": "Know your max bid before you bid — AI analysis of salvage auction listings.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p extension",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=chromium",
    "test:smoke": "playwright test --project=chromium e2e/smoke.spec.ts",
    "test:regression": "playwright test --project=chromium --grep @regression",
    "test:a11y": "playwright test --project=chromium --grep @a11y",
    "test:devices": "playwright test --project=chromium --grep \"@devices|@slow|@offline\"",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "eval": "vitest run --config vitest.eval.config.ts",
    "eval:live": "EVAL_LIVE=1 vitest run --config vitest.eval.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "audit:deps": "node scripts/audit-gate.mjs",
    "secrets:scan": "node scripts/secret-scan.mjs",
    "email:check-dns": "node scripts/check-email-dns.mjs",
    "db:check-rls": "tsx scripts/check-rls.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore-test": "tsx scripts/db-restore-test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "extension:build": "node extension/build.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.71",
    "@ai-sdk/openai": "4.0.83",
    "@hookform/resolvers": "5.9.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-pdf/renderer": "4.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "5.104.0",
    "ai": "7.0.126",
    "cheerio": "1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "geist": "1.7.2",
    "inngest": "4.21.0",
    "lucide-react": "1.49.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "recharts": "3.10.1",
    "resend": "6.31.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "stripe": "23.0.0",
    "tailwind-merge": "3.7.0",
    "vaul": "1.1.2",
    "zipcodes": "8.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/eslintrc": "3.3.7",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/chrome": "0.3.4",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/zipcodes": "8.0.5",
    "dotenv": "18.0.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "undici": ">=7.30.1",
      "fast-uri": ">=3.1.9",
      "mysql2": ">=3.23.1",
      "systeminformation": ">=5.33.16",
      "@hookform/resolvers>effect": ">=3.22.1"
    }
  }
}
