# ─────────────────────────────────────────────────────────────────────────────
# AuctionPulse AI — environment variables
# Copy to `.env` and fill in what you have. Every key except DATABASE_URL is
# optional: a missing provider key switches that provider to demo/fallback mode.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_URL=http://localhost:3000

# true  = sample lots + fixture data + "Continue as demo user" login button.
# false = live providers only (keys below must be set for the features you use).
DEMO_MODE=true
# When DEMO_MODE is not set at all, demo sign-in is on until Supabase login is configured.

# ── Database (Supabase Postgres in production; any Postgres locally) ─────────
# Pooled connection used at runtime (Supabase: port 6543 + ?pgbouncer=true)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auctionpulse
# Direct connection used for migrations (Supabase: port 5432)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/auctionpulse

# ── Supabase Auth + Storage (optional locally; required in production) ──────
# Without these, the app uses the built-in demo user and local disk for photos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTOS_BUCKET=listing-photos

# Comma-separated emails that get the ADMIN role on first sign-in
ADMIN_EMAILS=

# ── AI (vision damage audit, text extraction, narrative) ────────────────────
AI_PROVIDER=anthropic           # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL_VISION=claude-sonnet-5-5
AI_MODEL_TEXT=claude-haiku-4-5-20251001
AI_MAX_PHOTOS=24
# USD per million tokens, used for cost tracking (input,output)
AI_PRICE_VISION=3,15
AI_PRICE_TEXT=1,5

# ── Listing fetching (optional; paste-text and the extension work without) ──
SCRAPINGBEE_API_KEY=
# Without a page-reading key the app first tries reading the lot page directly (often blocked
# by auction sites), then asks for a few details prefilled from the link. "false" skips the try.
LISTING_DIRECT_FETCH=
APIFY_TOKEN=

# ── Vehicle history + market data (optional; fallbacks exist) ───────────────
VINAUDIT_API_KEY=
MARKETCHECK_API_KEY=

# ── Background jobs ──────────────────────────────────────────────────────────
# Without Inngest keys analyses run in-process (fine for local dev / small scale).
# Set INNGEST_DEV=1 to use the local Inngest dev server (pnpm inngest:dev).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=
# Protects /api/cron/* when called by an external scheduler (Vercel Cron)
CRON_SECRET=

# ── Billing (Stripe test mode works without real charges) ───────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_CREDITS_10=

# ── Email (watchlist reminders) ─────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=AuctionPulse <alerts@example.com>
