# ─────────────────────────────────────────────────────────────────────────────
# FlagBid — environment variables
# Copy to `.env` and fill in what you have. Every key except DATABASE_URL is
# optional: a missing provider key switches that provider to demo/fallback mode.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_URL=http://localhost:3000

# true  = sample lots + fixture data + "Continue as demo user" login button.
# false = live providers only (keys below must be set for the features you use).
DEMO_MODE=true
# When DEMO_MODE is not set at all, demo sign-in is on until Supabase login is configured.

# ── Database (Supabase Postgres in production; any Postgres locally) ─────────
# Pooled connection used at runtime (Supabase: port 6543 + ?pgbouncer=true)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auctionpulse
# Direct connection used for migrations (Supabase: port 5432)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/auctionpulse

# ── Supabase Auth + Storage (optional locally; required in production) ──────
# Without these, the app uses the built-in demo user and local disk for photos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTOS_BUCKET=listing-photos
# Without Supabase Storage, photos live in Postgres on serverless hosts (Vercel) and on local disk
# elsewhere. Set PHOTO_STORAGE=db or PHOTO_STORAGE=disk to force one.
# PHOTO_STORAGE=

# Comma-separated emails that get the ADMIN role on first sign-in
ADMIN_EMAILS=

# ── AI (vision damage audit, text extraction, narrative) ────────────────────
AI_PROVIDER=anthropic           # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL_VISION=claude-sonnet-5-5
AI_MODEL_TEXT=claude-haiku-4-5-20251001
AI_MAX_PHOTOS=24
# Photos per lot that may be fetched through ScrapingBee (1 credit each) when the photo host blocks
# direct downloads. Direct downloads are free. 0 = never pay for photos.
SCRAPER_MAX_PAID_PHOTOS=10
# USD per million tokens, used for cost tracking (input,output)
AI_PRICE_VISION=3,15
AI_PRICE_TEXT=1,5

# ── Listing fetching (optional; paste-text and the extension work without) ──
SCRAPINGBEE_API_KEY=
# Without a page-reading key the app first tries reading the lot page directly (often blocked
# by auction sites), then asks for a few details prefilled from the link. "false" skips the try.
LISTING_DIRECT_FETCH=
APIFY_TOKEN=

# ── Vehicle history + market data (optional; fallbacks exist) ───────────────
VINAUDIT_API_KEY=
MARKETCHECK_API_KEY=

# ── Real part prices (optional; without it the reference table + AI estimates are used) ─
# eBay developer keyset (production), from https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_US is the default; prices are read in USD
EBAY_MARKETPLACE=EBAY_US

# ── Background jobs ──────────────────────────────────────────────────────────
# Without Inngest keys analyses run in-process (fine for local dev / small scale).
# Set INNGEST_DEV=1 to use the local Inngest dev server (pnpm inngest:dev).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=
# Protects /api/cron/* when called by an external scheduler (Vercel Cron)
CRON_SECRET=

# ── Billing (Stripe test mode works without real charges) ───────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe price IDs; create the prices in EUR (amounts are in lib/billing/plans.ts)
STRIPE_PRICE_PACK_10=
STRIPE_PRICE_PACK_30=
STRIPE_PRICE_PACK_100=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# Set to true once Stripe Tax is set up (head-office address, registrations, tax behaviour on the prices)
STRIPE_AUTOMATIC_TAX=false

# ── Email (watchlist reminders) ─────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=FlagBid <alerts@example.com>

# ── Who runs this (Terms, Privacy, DMCA page, footer of every email) ────────
# Required before taking real customers: laws such as CAN-SPAM and the GDPR require the
# operator's name and a postal address. Until set, those pages show a placeholder.
LEGAL_ENTITY=
LEGAL_ADDRESS=
SUPPORT_EMAIL=
# DMCA designated agent (register at https://www.copyright.gov/dmca-directory/ — a US $6 fee)
DMCA_AGENT_NAME=
DMCA_AGENT_EMAIL=
DMCA_AGENT_ADDRESS=
DMCA_REGISTRATION_NUMBER=

# ── Security ────────────────────────────────────────────────────────────────
# Signs one-click unsubscribe links. Generate: openssl rand -hex 32
APP_SECRET=
# Set to true to take the whole app offline at once (503 page; /api/health stays up)
MAINTENANCE_MODE=
# staging = never indexed by search engines (Vercel preview deployments are treated as staging automatically)
APP_ENV=

# ── Monitoring and alerts (all optional) ────────────────────────────────────
# Slack/Discord incoming-webhook URL: new errors, failed payments, chargebacks, spend caps
ALERT_WEBHOOK_URL=
ALERT_EMAIL=
# Sentry error tracking (DSN only; session replay is never enabled)
SENTRY_DSN=

# ── Spend caps (0 = no cap). At the cap the app falls back to its no-AI path ─
AI_DAILY_BUDGET_USD=25
AI_MONTHLY_BUDGET_USD=250
# Paid page-reader calls (ScrapingBee/Apify) per day across all users
SCRAPE_DAILY_CAP=400

# ── Backups (scripts/db-backup.mjs) ─────────────────────────────────────────
# Encrypts the dump with AES-256; keep this in a password manager, NOT only here
BACKUP_PASSPHRASE=
